[Unit]
Description=Pause mpvpaper when the wallpaper is not visible
Documentation=https://github.com/GhostNaN/mpvpaper
PartOf=sway-session.target
After=dms.service

[Service]
Type=simple
ExecStart=%h/.local/bin/mpvpaper-visibility
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=sway-session.target
